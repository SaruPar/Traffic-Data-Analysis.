#importing necessary libraries.

---------------------------------------------------------------------------
import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns
import os


from sklearn.preprocessing import (OneHotEncoder, StandardScaler)
from sklearn.pipeline import Pipeline
from sklearn.compose import ColumnTransformer
from sklearn.impute import SimpleImputer
from sklearn.model_selection import (train_test_split, cross_val_score)
from sklearn.dummy import DummyClassifier
from sklearn.linear_model import LogisticRegression
from sklearn.tree import DecisionTreeClassifier
from sklearn.ensemble import RandomForestClassifier
from sklearn.metrics import (accuracy_score, precision_score, 
                             recall_score, f1_score, confusion_matrix,
                             classification_report)
----------------------------------------------------------------------------


#Creating folder to save results.
----------------------------------------------------------------------------
output_dir = os.path.join(os.path.dirname(os.path.abspath(__file__)),
                          "Model_Comparison")
os.makedirs(output_dir, exist_ok = True)
----------------------------------------------------------------------------

#Loading data.
----------------------------------------------------------------------------
df = pd.read_csv("/Users/sp/Downloads/Montana_Statewide.csv.zip",
                  low_memory = False)

----------------------------------------------------------------------------

#DataExploration
-----------------------------------------------------------------------------

print(df.head(3))
print (df.info())
for column in df.columns:
    print ("\n", df[column].value_counts())
    print ("\n", df[column].nunique())


df = df.drop(columns = df.columns[(df.nunique()>100) | (df.nunique() ==1) ])
print (df.info())
df = df.drop(columns =["arrest_made", "citation_issued", "warning_issued",])
df = df.drop(columns = 'raw_Race')
print (df.info())
----------------------------------------------------------------------------

#Selecting Taget column, here 'outcome' column which has 3 categories. 
#a. Arrest.
#b. Warning Issued.
#c. Citation Issued.
----------------------------------------------------------------------------
df = df.dropna(subset = ['outcome'])
Y= df["outcome"]
X = df.drop(columns =["outcome"])
print(X.info())
print(X.select_dtypes(include= ["int64", "float64"]).shape[1])
----------------------------------------------------------------------------

#Plotting Graph of each feature against "outcome" column.
----------------------------------------------------------------------------
for a in X.columns:
    fig, ax = plt.subplots(1,1, figsize = (6,4))
    sns.countplot (data = X, x = X[a], hue = Y )
    ax.set_title(f"{a} - Outcome Graph")
    ax.set_xlabel(f"{a}")
    ax.set_ylabel("Count")
    ax.tick_params(axis = 'x', rotation = 45)
    fig.tight_layout()
    plt.show()

print("Solved")
-----------------------------------------------------------------------------

#Training Models.
-----------------------------------------------------------------------------
X_train, X_test, Y_train, Y_test = train_test_split(X, Y, test_size = 0.2, stratify = Y, random_state = 42)
numeric_columns = X_train.select_dtypes(include = ["int64", "float64"]).columns
categorical_columns = X_train.select_dtypes(include = ["object", "bool", "category"]).columns

numeric_pipeline = Pipeline([('imputer', SimpleImputer(strategy  = 'median')), 
                            ('scaler', StandardScaler())])
categorical_pipeline = Pipeline([('impute', SimpleImputer(strategy = 'most_frequent')), ('encoder', 
                                 OneHotEncoder(handle_unknown = "ignore", sparse_output = True ))])

preprocessor = ColumnTransformer([('numeric', numeric_pipeline, numeric_columns),
                                  ('categorical', categorical_pipeline, categorical_columns)])

X_train_preprocessed = preprocessor.fit_transform(X_train)
X_test_preprocessed = preprocessor.transform(X_test)
-----------------------------------------------------------------------------

# Testing with different models:
#a. Dummy Classifier.
#b. Logistic Regression.
#c. Decesion Tree
#d. Random Forest
-----------------------------------------------------------------------------
def model_comparison (model_name, model, x_train, x_test, y_train, y_test):
    model.fit(x_train, y_train)
    pred = model.predict(x_test)
    accuracy = accuracy_score(y_test, pred)
    precision = precision_score(y_test, pred, average = 'weighted', 
                                zero_division = 0)
    recall = recall_score(y_test, pred, average = 'weighted', zero_division = 0)
    F1 = f1_score(y_test, pred, average = 'weighted', zero_division = 0)
    CV_Score = cross_val_score(model, x_train, y_train, 
                               cv = 5, scoring = "f1_weighted")
    Confusion_matrix = confusion_matrix(y_test, pred)
    Classification_report = classification_report(y_test, pred, zero_division = 0 )
    print (model_name, "Confusion_matrix : \n", Confusion_matrix)
    print (model_name, "Classification_report : \n", Classification_report)
    
    return {
      "Model_name" : model_name, 
      "Accuracy" : accuracy,
      "Precision" : precision,
      "Recall" : recall, 
      "F1" : F1,
      "CV_score": CV_Score,
      "CV_score_mean": CV_Score.mean()
    }
  

model = [("Dummy_Baseline", DummyClassifier(strategy = "most_frequent")),
          ("Logistic_Regression", LogisticRegression(max_iter = 1000)), 
          ("Decision_Tree", DecisionTreeClassifier(random_state = 42)), 
          ("Random_Forest",RandomForestClassifier(n_estimators =20, 
                                                  max_depth = 4,
                                                  random_state = 42))]

results = []   
print("STARTING MODELS")
for a,b in model:
    result = model_comparison(a, b, X_train_preprocessed, X_test_preprocessed, 
                               Y_train, Y_test)
    results.append(result)
print("ALL MODELS FINISHED")
results_df = pd.DataFrame(results).set_index("Model_name")
print (results_df)
-----------------------------------------------------------------------------

#Plotting metrics of each model in one graph.
#a. Accuracy.
#b. Precision.
#c. Recall Score.
#d. F1 Score.
-----------------------------------------------------------------------------
fig, axes = plt.subplots(2,2, figsize = (14,10))
for ax, metric in zip(axes.flat, results_df.columns[:4]):

    sns.barplot(data = results_df, x = results_df.index, 
                y = metric, ax = ax)
    ax.set_title (f"{metric} - ModelComparison")
    ax.set_xlabel("Models")
    ax.set_ylabel(metric)
    ax.tick_params(axis = "x", rotation = 45)

plt.tight_layout()
plt.savefig( os.path.join(output_dir,
                          "Model_Comparison.png"), dpi = 300,
                          bbox_inches = 'tight')
plt.show()
